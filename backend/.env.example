# =============================================================================
# TestGen AI — Backend Environment Variables
# V1.0 Frozen Baseline
#
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Runtime environment: development | testing | production
ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# CORS — JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite (default) — use a full PostgreSQL URL in production
# postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./testgen.db

# -----------------------------------------------------------------------------
# LLM — Google Gemini
# -----------------------------------------------------------------------------
# Required: obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Model variant (gemini-2.0-flash recommended for speed + cost)
GEMINI_MODEL=gemini-2.0-flash

# Sampling temperature — lower = more deterministic (0.0–1.0)
GEMINI_TEMPERATURE=0.3

# Maximum tokens in the LLM response
GEMINI_MAX_OUTPUT_TOKENS=4096

# Seconds before an LLM call is cancelled
GEMINI_TIMEOUT_SECONDS=60

# Number of automatic retries on transient failures
GEMINI_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Input Limits
# -----------------------------------------------------------------------------
# Maximum source code payload size in bytes (default: 50 KB)
MAX_SOURCE_CODE_SIZE=50000

# Maximum specification payload size in bytes (default: 10 KB)
MAX_SPECIFICATION_SIZE=10000

# -----------------------------------------------------------------------------
# Prompt Versioning
# -----------------------------------------------------------------------------
# Which prompt version subdirectory to load (prompts/<PROMPT_VERSION>/)
# Do NOT change without deploying the corresponding prompts/<version>/ directory.
PROMPT_VERSION=v1

# -----------------------------------------------------------------------------
# V2 Feature Flags
# -----------------------------------------------------------------------------
ENABLE_SANDBOX=false
ENABLE_RAG=false
ENABLE_SELF_HEAL=false
ENABLE_REVIEW=false
ENABLE_CONFIDENCE=true
ENABLE_MULTI_PROVIDER=false
ENABLE_EXPLAINABILITY=false

# -----------------------------------------------------------------------------
# Sandbox Configuration
# Required when ENABLE_SANDBOX=true.
# -----------------------------------------------------------------------------

# URL of the SandboxExecutor sidecar process
SANDBOX_URL=http://127.0.0.1:8001

# Shared secret — must match the SANDBOX_SECRET set when starting executor.py
# Generate a strong value: openssl rand -hex 32
SANDBOX_SECRET=CHANGE_THIS_SANDBOX_SECRET_IN_PRODUCTION

# Wall-clock timeout per container execution (seconds). Recommend 10+.
SANDBOX_TIMEOUT_SECONDS=10

# Maximum simultaneous Docker containers. Excess requests receive HTTP 503.
SANDBOX_MAX_CONCURRENT_CONTAINERS=5

# Memory cap per container (MB)
SANDBOX_MEMORY_MB=128

# Docker image to use for isolated test execution.
# This image MUST have pytest pre-installed.
# Build the custom image before starting the sandbox executor:
#   cd backend && docker build -t testgen-sandbox:latest ./sandbox
SANDBOX_DOCKER_IMAGE=testgen-sandbox:latest
